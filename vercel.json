{
  "redirects": [{ "source": "/landings", "destination": "/landings/ia-desde-cero", "permanent": false }],
  "headers": [
    {
      "source": "/landings/ia-desde-cero/api/registrations/nonce",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://ebiacapacitacion.com" },
