# Cuenta global de ActiveCampaign. Solo el subdominio.
NEXT_PUBLIC_ACTIVE_CAMPAIGN_ACCOUNT=cefincapacitacion

# Pixel global utilizado por las landings de la misma operación.
NEXT_PUBLIC_META_PIXEL_ID=

# Checkout oficial de Hotmart para la landing Ecosistema IA.
NEXT_PUBLIC_HOTMART_CHECKOUT_URL=https://pay.hotmart.com/Y106920957U?off=nzn1qn7n&checkoutMode=10

# Checkout oficial de Hotmart para IA para Maestros: De Cero al Aula.
NEXT_PUBLIC_HOTMART_CHECKOUT_URL_IA_MAESTROS=https://pay.hotmart.com/M107670322C?off=f4a0vm6y&checkoutMode=10

# Grupo específico de la landing IA desde cero; se lee únicamente en el servidor.
WHATSAPP_GROUP_URL_IA_DESDE_CERO=

# Grupo específico de la landing IA para Maestros; solo se lee en servidor.
WHATSAPP_GROUP_URL_IA_MAESTROS=

# Secreto aleatorio por entorno, mínimo 32 caracteres, para firmar nonce/cookie.
REGISTRATION_TOKEN_SECRET=
