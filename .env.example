# Grupo específico de la landing IA desde cero; se lee únicamente en el servidor.
WHATSAPP_GROUP_URL_IA_DESDE_CERO=

# Secreto aleatorio por entorno, mínimo 32 caracteres, para firmar nonce/cookie.
REGISTRATION_TOKEN_SECRET=
