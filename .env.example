# Cuenta global de ActiveCampaign. Solo el subdominio.
NEXT_PUBLIC_ACTIVE_CAMPAIGN_ACCOUNT=

# Pixel global utilizado por las landings de la misma operación.
NEXT_PUBLIC_META_PIXEL_ID=

# Checkout oficial de Hotmart para la landing Ecosistema IA.
